
Uses XOR to cancel out numbers:

XOR all numbers from 0 → n
XOR all elements in array
Remaining value = missing number

Time Complexity
O(n)
Space Complexity
O(1)

---------------------------------------------------------------------------------------------------


class Solution {
    public int missingNumber(int[] nums) {
        int n= nums.length;
        int xor = 0;
        for(int i=0;i<=n;i++){
            xor^=i;
        }
        for(int num:nums){
            xor^=num;
        }
        return xor;
        
        
    }
}
