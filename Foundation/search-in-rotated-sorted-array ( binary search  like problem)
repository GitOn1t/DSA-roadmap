
This code uses a modified binary search to find a target in a rotated sorted array.
In each iteration, it checks which half of the array is sorted, determines whether the target lies in that half using boundary comparisons (nums[start], nums[end]), and discards the other half.
Complexities:

Time Complexity: O(log n) — halves the search space each step
Space Complexity: O(1) — uses constant extra space
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

class Solution {
    public int search(int[] nums, int target) {

        int start=0, end=nums.length-1;
        while(start<=end){
            int mid= start+(end-start)/2;
            if (nums[mid]==target) return mid;

            if(nums[mid]>=nums[start]){
                if(target>=nums[start] && target<nums[mid]){
                    end=mid-1;
                }else{
                    start=mid+1;
                }
            }else{
                if(target>nums[mid] && target<=nums[end]){
                    start=mid+1;
                }else{
                    end=mid-1;
                }
            }
        }
        return -1;
        
    }
}
